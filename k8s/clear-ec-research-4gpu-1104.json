{
 "apiVersion": "v1",
 "kind": "Pod",
 "metadata": {
  "annotations": {
   "mlx/recreated-from": "clear-ec-research-4gpu-1026 (2026-11-04: container OOMKilled at the 96Gi limit; same image, limit raised to 192Gi)"
  },
  "labels": {
   "app": "clear-ec",
   "mlx.navercorp.com/zone": "private-h200-ajou-mlxp-0",
   "stage": "persistent-research"
  },
  "name": "clear-ec-research-4gpu-1104",
  "namespace": "p-ajou-mlxp-project"
 },
 "spec": {
  "containers": [
   {
    "args": [
     "trap \"exit 0\" TERM INT; while true; do sleep 300 & wait $!; done"
    ],
    "command": [
     "bash",
     "-lc"
    ],
    "env": [
     {
      "name": "PYTHONPATH",
      "value": "/workspace/clear-ec-research/experiments/phase2_foundation_20261002/runtime"
     },
     {
      "name": "HF_HUB_OFFLINE",
      "value": "1"
     },
     {
      "name": "HF_HUB_DISABLE_PROGRESS_BARS",
      "value": "1"
     },
     {
      "name": "PYTHONDONTWRITEBYTECODE",
      "value": "1"
     },
     {
      "name": "OMP_NUM_THREADS",
      "value": "4"
     },
     {
      "name": "OPENBLAS_NUM_THREADS",
      "value": "2"
     },
     {
      "name": "PYTORCH_CUDA_ALLOC_CONF",
      "value": "expandable_segments:True"
     },
     {
      "name": "NCCL_IB_HCA",
      "value": "mlx5_0,mlx5_2,mlx5_3,mlx5_4,mlx5_5,mlx5_7,mlx5_8,mlx5_9"
     }
    ],
    "image": "leebyounghan/mlx-rl:20261025-sgl0512-verl-1ddf071",
    "name": "train",
    "resources": {
     "limits": {
      "cpu": "16",
      "memory": "192Gi",
      "nvidia.com/gpu": "4"
     },
     "requests": {
      "cpu": "8",
      "memory": "40Gi",
      "nvidia.com/gpu": "4"
     }
    },
    "volumeMounts": [
     {
      "mountPath": "/workspace",
      "name": "workspace"
     },
     {
      "mountPath": "/dev/shm",
      "name": "shared-memory"
     }
    ],
    "workingDir": "/workspace/clear-ec-research"
   }
  ],
  "nodeSelector": {
   "mlx.navercorp.com/gpu-type": "H200",
   "mlx.navercorp.com/hardware-type": "gpu",
   "mlx.navercorp.com/zone": "private-h200-ajou-mlxp-0"
  },
  "restartPolicy": "Never",
  "terminationGracePeriodSeconds": 30,
  "volumes": [
   {
    "name": "workspace",
    "persistentVolumeClaim": {
     "claimName": "clear-ec-workspace"
    }
   },
   {
    "emptyDir": {
     "medium": "Memory",
     "sizeLimit": "16Gi"
    },
    "name": "shared-memory"
   }
  ]
 }
}