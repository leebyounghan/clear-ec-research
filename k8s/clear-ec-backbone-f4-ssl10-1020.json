{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "clear-ec-backbone-f4-ssl10-1020",
    "namespace": "p-ajou-mlxp-project",
    "labels": {
      "app": "clear-ec",
      "workload": "backbone-ssl-1020",
      "stage": "ssl10",
      "fold": "4"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app": "clear-ec",
          "workload": "backbone-ssl-1020",
          "stage": "ssl10",
          "fold": "4"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "priorityClassName": "private-zone",
        "preemptionPolicy": "Never",
        "restartPolicy": "Never",
        "nodeSelector": {
          "mlx.navercorp.com/gpu-type": "H200",
          "mlx.navercorp.com/zone": "private-h200-ajou-mlxp-0"
        },
        "tolerations": [
          {
            "key": "nvidia.com/gpu",
            "operator": "Exists",
            "effect": "NoSchedule"
          }
        ],
        "containers": [
          {
            "name": "train",
            "image": "leebyounghan/mlx-rl:20260810-sgl0512-verl-1ddf071",
            "workingDir": "/workspace/clear-ec-research",
            "command": [
              "bash",
              "-lc"
            ],
            "args": [
              "set -euo pipefail\nroot=experiments/phase2_backbone_ssl_20261020/fold4/ssl10\nexec 9>\"$root/execution.lock\"\nflock -n 9\n test ! -e \"$root/launch.json\"\n test ! -e \"$root/run\"\n /workspace/venv/bin/python -c 'import json,datetime,os; print(json.dumps(dict(started_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),pod=os.environ.get(\"HOSTNAME\"))))' > \"$root/launch.json\"\nexec > >(tee -a \"$root/full.log\") 2>&1\ntrap 'rc=$?; /workspace/venv/bin/python -c \"import json,datetime; print(json.dumps(dict(exit_code=$rc,finished_utc=datetime.datetime.now(datetime.timezone.utc).isoformat())))\" > \"$root/exit.json\"' EXIT\nrunner=\"$root/source/phase2_backbone_ssl_20261020.py\"\ncommon=(--root \"$root\" --split experiments/target_fold4_20260912/preflight/fold4.npz --fold 4 --seed 1003 --epochs 10 --deadline-utc none)\n/workspace/venv/bin/python -u \"$runner\" smoke \"${common[@]}\"\n/workspace/venv/bin/python -u \"$runner\" train \"${common[@]}\"\n"
            ],
            "env": [
              {
                "name": "PYTHONPATH",
                "value": "/workspace/clear-ec-research/experiments/phase2_foundation_20261002/runtime"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "HF_HUB_DISABLE_PROGRESS_BARS",
                "value": "1"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              },
              {
                "name": "OMP_NUM_THREADS",
                "value": "4"
              },
              {
                "name": "OPENBLAS_NUM_THREADS",
                "value": "2"
              },
              {
                "name": "PYTORCH_CUDA_ALLOC_CONF",
                "value": "expandable_segments:True"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "4",
                "memory": "20Gi",
                "nvidia.com/gpu": "1"
              },
              "limits": {
                "cpu": "8",
                "memory": "48Gi",
                "nvidia.com/gpu": "1"
              }
            },
            "volumeMounts": [
              {
                "name": "workspace",
                "mountPath": "/workspace"
              },
              {
                "name": "shared-memory",
                "mountPath": "/dev/shm"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "workspace",
            "persistentVolumeClaim": {
              "claimName": "clear-ec-workspace"
            }
          },
          {
            "name": "shared-memory",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "4Gi"
            }
          }
        ]
      }
    }
  }
}
